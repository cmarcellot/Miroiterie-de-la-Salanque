# Copie ce fichier en .env.local pour le dev, et renseigne les variables dans Dokploy pour la prod.

# --- Base de données ---
# URL interne Dokploy en prod : mongodb://user:pass@entreprise-db:27017/entreprise?authSource=admin
MONGODB_URI=

# --- Espace pro (authentification) ---
# Secret de session : openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publique du site (sans slash final)
NEXTAUTH_URL=http://localhost:3000

# Compte gérant unique : créé automatiquement au premier login avec ces identifiants.
# Après la première connexion, l'utilisateur existe en base ; ces variables ne servent plus.
ADMIN_EMAIL=
ADMIN_PASSWORD=
