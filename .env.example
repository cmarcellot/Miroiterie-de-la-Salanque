# Copie ce fichier en .env.local pour le dev, et renseigne les variables dans Dokploy pour la prod.

# --- Base de données ---
# URL interne Dokploy en prod : mongodb://user:pass@entreprise-db:27017/entreprise?authSource=admin
MONGODB_URI=

# --- Espace pro (authentification) ---
# Secret de session : openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publique du site (sans slash final)
NEXTAUTH_URL=http://localhost:3000

# Compte gérant unique : créé automatiquement au premier login avec ces identifiants.
# Après la première connexion, l'utilisateur existe en base ; ces variables ne servent plus.
# La connexion elle-même (modal "Espace pro") ne demande ensuite que le mot de passe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Envoi d'email (devis/factures) ---
# Identifiants SMTP du compte utilisé pour l'envoi. Avec Gmail, SMTP_PASS
# doit être un "mot de passe d'application" (myaccount.google.com/apppasswords),
# pas le mot de passe du compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optionnel : adresse d'expédition si différente de SMTP_USER, ex. "Miroiterie de la Salanque <contact@...>"
SMTP_FROM=

# --- Avis Google (page d'accueil) ---
# Clé Places API (New), restreinte à cette seule API. Serveur uniquement : ne jamais préfixer NEXT_PUBLIC_.
# Sans ces deux variables, la section des avis ne s'affiche simplement pas.
GOOGLE_PLACES_API_KEY=
# Place ID de la fiche Google "Miroiterie de la Salanque" (Sainte-Marie-la-Mer), trouvé une fois via Text Search.
GOOGLE_PLACE_ID=
